module;
#include <cstdint>
#include <set>
#include <vector>
#include <memory>
#include <array>

export module dimna.policy.filter.soa_filter;

import mna.model.job;
import mna.model.soa;

import dimna.allocator.constants;
import dimna.model.solution;

namespace mna::di::policy {

export template <int CutSol> class SoAFilter;

template<>
class SoAFilter<2>{
public:
  std::vector<int>
  preselect_nodes(std::shared_ptr<IoTNetworkSoA> network, mna::Job& job, std::vector<int32_t>& latencies, int cut_comb_nodes){
    
    std::set<int> valid_nodes;
    int num_nodes = network->vertex_count();
    int combs_found{};

    auto& nodes = network->vertexes();

    auto jr_job = job.resource;
    auto jb_job = job.bandwidth;
    auto l_job = job.latency - t_c;

    for (int i = 0; i < num_nodes && combs_found < cut_comb_nodes; ++i){
      if (static_cast<bool>(nodes.busy[i]))
        continue;
      
      auto single_R = nodes.resource[i];
      auto single_B = nodes.bandwidth[i];
      auto single_L = latencies[i];
      
      if (single_R >= jr_job && single_B >= jb_job && single_L <= l_job){
          valid_nodes.insert(i);
          ++combs_found;
      }
    }
    // Looking for valid node combinations
    for (int i = 0; i < num_nodes && combs_found < cut_comb_nodes; ++i){

      if (static_cast<bool>(nodes.busy[i]))
        continue;

      auto single_R = nodes.resource[i];
      auto single_B = nodes.bandwidth[i];
      auto single_L = latencies[i];

      for (int j = i + 1; j < num_nodes && combs_found < cut_comb_nodes; ++j){

        if (static_cast<bool>(nodes.busy[j]))
          continue;
        
        auto total_R = single_R + nodes.resource[j];
        auto total_B = single_B + nodes.bandwidth[j];
        auto max_L = std::max(single_L, latencies[j]);
          
        if (total_R >= jr_job && total_B >= jb_job && max_L <= l_job){
      
          valid_nodes.insert(i);
          valid_nodes.insert(j);
          ++combs_found;
        }
      }
    }
    return std::vector<int>(valid_nodes.begin(), valid_nodes.end());
  }
};

template<>
class SoAFilter<3>{
public:
  std::vector<int>
  preselect_nodes(std::shared_ptr<IoTNetworkSoA> network, mna::Job& job, std::vector<int32_t>& latencies, int cut_comb_nodes){
    
    std::set<int> valid_nodes;
    int num_nodes = network->vertex_count();
    int combs_found{};

    auto& nodes = network->vertexes();

    auto jr_job = job.resource;
    auto jb_job = job.bandwidth;
    auto l_job = job.latency - t_c;


    for (int i = 0; i < num_nodes && combs_found < cut_comb_nodes; ++i){
      if (static_cast<bool>(nodes.busy[i]))
        continue;
      
      auto single_R = nodes.resource[i];
      auto single_B = nodes.bandwidth[i];
      auto single_L = latencies[i];
      
      if (single_R >= jr_job && single_B >= jb_job && single_L <= l_job){
          valid_nodes.insert(i);
          ++combs_found;
      }
    }
    // Looking for valid node combinations
    for (int i = 0; i < num_nodes && combs_found < cut_comb_nodes; ++i){

      if (static_cast<bool>(nodes.busy[i]))
        continue;

      auto single_R = nodes.resource[i];
      auto single_B = nodes.bandwidth[i];
      auto single_L = latencies[i];

      for (int j = i + 1; j < num_nodes && combs_found < cut_comb_nodes; ++j){

        if (static_cast<bool>(nodes.busy[j]))
          continue;
        
        auto total_R = single_R + nodes.resource[j];
        auto total_B = single_B + nodes.bandwidth[j];
        auto max_L = std::max(single_L, latencies[j]);
          
        if (total_R >= jr_job && total_B >= jb_job && max_L <= l_job){
      
          valid_nodes.insert(i);
          valid_nodes.insert(j);
          ++combs_found;
        }
      }
    }

    std::array<decltype(jr_job), 3> partial_R;
    std::array<decltype(jb_job), 3> partial_B;
    std::array<decltype(l_job), 3> max_L;

    for (int i = 0; i < num_nodes && combs_found < cut_comb_nodes; ++i){

      if (static_cast<bool>(nodes.busy[i]))
        continue;

      partial_R[0] = nodes.resource[i];
      partial_B[0] = nodes.bandwidth[i];
      max_L[0] = latencies[i];

      for (int j = i + 1; j < num_nodes && combs_found < cut_comb_nodes; ++j){

        if (static_cast<bool>(nodes.busy[j]))
          continue;
        
        partial_R[1] = partial_R[0] + nodes.resource[j];
        partial_B[1] = partial_B[0] + nodes.bandwidth[j];
        max_L[1] = std::max(max_L[0], latencies[j]);

        for (int k = j + 1; k < num_nodes && combs_found < cut_comb_nodes; ++k){

          if (static_cast<bool>(nodes.busy[k]))
            continue;
          
          partial_R[2] = partial_R[1] + nodes.resource[k];
          partial_B[2] = partial_B[1] + nodes.bandwidth[k];
          max_L[2] = std::max(max_L[1], latencies[k]);

          if (partial_R[2] >= jr_job && partial_B[2] >= jb_job && max_L[2] <= l_job){
        
            valid_nodes.insert(i);
            valid_nodes.insert(j);
            valid_nodes.insert(k);
            ++combs_found;
          }
        }
          
      }
    }

    return std::vector<int>(valid_nodes.begin(), valid_nodes.end());
  }
};
} // Namespace mna::di::policy
