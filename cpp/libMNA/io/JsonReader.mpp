module;
#include <cstdint>
#include <memory>
#include <filesystem>
#include <functional>
#include <fstream>
#include <vector>
export module mna.io.json_reader;

namespace mna {

namespace fs = std::filesystem;

export class JsonReader{
private:
  using VertexCallback = std::function<void(int64_t R, int64_t B, int64_t busy, int64_t inactive)>;
  using EdgeCallback = std::function<void(int32_t source, int32_t target, int32_t latency)>;
  using JobCallback = std::function<void(int64_t jr, int64_t jb, int64_t jl, int64_t jo)>;

public:
  int get_num_vertexes(fs::path instance_file);

  void read_instance(fs::path instance_file, VertexCallback consume_vertex, EdgeCallback consume_edge, JobCallback consume_job);
  void read_jobs(fs::path jobs_file, JobCallback consume_job);
};


} // namespace mna

